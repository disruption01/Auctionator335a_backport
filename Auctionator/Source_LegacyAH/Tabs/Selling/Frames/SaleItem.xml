<Ui xmlns="http://www.blizzard.com/wow/ui/">
  <Frame name="AuctionatorSaleItemFrameTemplate" virtual="true">
    <Size x="600" y="100"/>

    <Scripts>
      <OnLoad>Mixin(self, AuctionatorSaleItemMixin); if self:GetParent() then self:GetParent().AuctionatorSaleItem = self end; if self:GetName() then self.Deposit = _G[self:GetName() .. 'Deposit'] end; if self:GetName() then self.DepositPrice = _G[self:GetName() .. 'DepositPrice'] end; if self:GetName() then self.Total = _G[self:GetName() .. 'Total'] end; if self:GetName() then self.TotalPrice = _G[self:GetName() .. 'TotalPrice'] end; if self.OnLoad then self:OnLoad() end</OnLoad>
      <OnUpdate>if self.OnUpdate then self:OnUpdate(elapsed) end</OnUpdate>
      <OnShow>if self.OnShow then self:OnShow() end</OnShow>
      <OnHide>if self.OnHide then self:OnHide() end</OnHide>
    </Scripts>

    <Frames>
      <Frame name="$parentTitleArea">
        <Size y="24"/>
        <Anchors>
          <Anchor point="TOPLEFT"/>
          <Anchor point="RIGHT"/>
        </Anchors>

        <Layers>
          <Layer>
            <FontString inherits="GameFontNormalLarge" name="$parentText">
              <Anchors>
                <Anchor point="TOPLEFT" x="15" y="-5"/>
              </Anchors>
            </FontString>
          </Layer>
        </Layers>
      <Scripts><OnLoad>if self:GetParent() then self:GetParent().TitleArea = self end; if self:GetName() then self.Text = _G[self:GetName() .. 'Text'] end</OnLoad></Scripts></Frame>
      <Frame name="$parentPostWatch">
        <Scripts>
          <OnLoad>Mixin(self, AuctionatorPostWatchMixin); if self:GetParent() then self:GetParent().PostWatch = self end</OnLoad><OnShow>if self.OnShow then self:OnShow() end</OnShow>
          <OnHide>if self.OnHide then self:OnHide() end</OnHide>
          <OnEvent>if self.OnEvent then self:OnEvent(event, ...) end</OnEvent>
        </Scripts>
      </Frame>

      <Button inherits="AuctionatorGroupsViewItemTemplate" registerForClicks="LeftButtonUp, RightButtonUp" registerForDrag="LeftButton" name="$parentIcon">
        <Size x="60" y="60"/>
        <Anchors>
          <Anchor point="TOPLEFT" relativePoint="BOTTOMLEFT" y="-5" x="-20" relativeTo="$parentTitleArea"/>
        </Anchors>
        <Scripts>
          <OnLoad>Mixin(self, AuctionatorGroupsViewItemMixin, AuctionatorBagItemSelectedMixin); if self:GetParent() then self:GetParent().Icon = self end; if self.RegisterForClicks then self:RegisterForClicks("LeftButtonUp", "RightButtonUp") end</OnLoad>
          <OnEnter>if self.OnEnter then self:OnEnter() end</OnEnter>
          <OnLeave>if self.OnLeave then self:OnLeave() end</OnLeave>
          <OnClick>if self.OnClick then self:OnClick(button, down) end</OnClick>
          <OnReceiveDrag>if self.OnReceiveDrag then self:OnReceiveDrag() end</OnReceiveDrag>
          <OnDragStart>if self.OnDragStart then self:OnDragStart() end</OnDragStart>
        </Scripts>
      </Button>

      <Frame inherits="AuctionatorConfigurationMoneyInputAlternate" name="$parentUnitPrice">
        <Anchors>
          <Anchor point="TOPLEFT" relativePoint="TOPRIGHT" y="5" relativeTo="$parentIcon"/>
          <Anchor point="RIGHT" relativePoint="RIGHT" x="330" relativeTo="$parentIcon"/>
        </Anchors>

        <Scripts><OnLoad>Mixin(self, AuctionatorConfigMoneyInputMixin); if self:GetParent() then self:GetParent().UnitPrice = self end; self.labelText = AUCTIONATOR_L_UNIT_PRICE; if self.OnLoad then self:OnLoad() end</OnLoad></Scripts></Frame>

      <Frame inherits="AuctionatorConfigurationMoneyInputAlternate" name="$parentStackPrice">
        <Anchors>
          <Anchor point="TOPLEFT" relativePoint="BOTTOMLEFT" y="-25" relativeTo="$parentUnitPrice"/>
          <Anchor point="RIGHT" relativeTo="$parentUnitPrice"/>
        </Anchors>

        <Scripts><OnLoad>Mixin(self, AuctionatorConfigMoneyInputMixin); if self:GetParent() then self:GetParent().StackPrice = self end; self.labelText = AUCTIONATOR_L_STACK_PRICE; if self.OnLoad then self:OnLoad() end</OnLoad></Scripts></Frame>

      <Frame inherits="AuctionatorStackOfInputTemplate" name="$parentStacks">
        <Anchors>
          <Anchor point="TOPLEFT" relativePoint="BOTTOMLEFT" y="-30" x="112" relativeTo="$parentStackPrice"/>
          <Anchor point="RIGHT" relativeTo="$parentUnitPrice"/>
        </Anchors>
      <Scripts><OnLoad>Mixin(self, AuctionatorStackOfInputMixin); if self:GetParent() then self:GetParent().Stacks = self end; if self.OnLoad then self:OnLoad() end</OnLoad></Scripts></Frame>

      <Frame inherits="AuctionatorDurationHorizontalRadioControls" name="$parentDuration">
        <Anchors>
          <Anchor point="TOPLEFT" relativePoint="TOPRIGHT" relativeTo="$parentUnitPrice"/>
          <Anchor point="RIGHT" relativePoint="RIGHT" x="200" relativeTo="$parentUnitPrice"/>
        </Anchors>
      <Scripts><OnLoad>Mixin(self, AuctionatorConfigHorizontalRadioButtonGroupMixin); self.groupHeadingText = AUCTIONATOR_L_DURATION; if self:GetParent() then self:GetParent().Duration = self end; if self.InitializeRadioButtonGroup then self:InitializeRadioButtonGroup() end</OnLoad></Scripts></Frame>
      <Button name="AuctionatorPostButton" inherits="UIPanelButtonTemplate" text="AUCTIONATOR_L_POST">
        <Size x="184" y="22"/>
        <Anchors>
          <Anchor point="TOPLEFT" relativePoint="BOTTOMLEFT" y="-19" x="20" relativeTo="$parentDuration"/>
        </Anchors>
        <Scripts>
          <OnLoad>if self:GetParent() then self:GetParent().PostButton = self end</OnLoad><OnClick>self:GetParent():PostItem()</OnClick>
        </Scripts>
      </Button>
      <Button name="AuctionatorSkipPostingButton" inherits="UIPanelButtonTemplate" text="AUCTIONATOR_L_SKIP" hidden="true">
        <Size x="80" y="22"/>
        <Anchors>
          <Anchor point="TOPLEFT" relativePoint="TOPRIGHT" relativeTo="$parentPostButton"/>
        </Anchors>
        <Scripts>
          <OnLoad>if self:GetParent() then self:GetParent().SkipButton = self end</OnLoad><OnClick>self:GetParent():SkipItem()</OnClick>
        </Scripts>
      </Button>
      <Button name="AuctionatorPrevPostingButton" inherits="UIPanelButtonTemplate" text="AUCTIONATOR_L_PREVIOUS" hidden="true">
        <Size x="80" y="22"/>
        <Anchors>
          <Anchor point="TOPRIGHT" relativePoint="TOPLEFT" relativeTo="$parentPostButton"/>
        </Anchors>
        <Scripts>
          <OnLoad>if self:GetParent() then self:GetParent().PrevButton = self end</OnLoad><OnClick>self:GetParent():PrevItem()</OnClick>
        </Scripts>
      </Button>

      <Frame inherits="AuctionatorConfigurationMoneyInputAlternate" hidden="true" name="$parentBidPrice">
        <Anchors>
          <Anchor point="TOPLEFT" relativePoint="BOTTOMLEFT" relativeTo="$parentPostButton"/>
        </Anchors>

        <Scripts><OnLoad>Mixin(self, AuctionatorConfigMoneyInputMixin); if self:GetParent() then self:GetParent().BidPrice = self end; self.labelText = AUCTIONATOR_L_STACK_BID_PRICE; if self.OnLoad then self:OnLoad() end</OnLoad></Scripts></Frame>
    </Frames>

    <Layers>
      <Layer level="BACKGROUND">
        <FontString inherits="GameFontNormal" Text="AUCTIONATOR_L_DEPOSIT" name="$parentDeposit">
          <Anchors>
            <Anchor point="TOPLEFT" relativePoint="TOPRIGHT" x="20" relativeTo="$parentDuration"/>
          </Anchors>
        </FontString>
      </Layer>

      <Layer level="BACKGROUND">
        <FontString inherits="GameFontHighlight" name="$parentDepositPrice">
          <Size y="25"/>
          <Anchors>
            <Anchor point="TOPLEFT" relativePoint="BOTTOMLEFT" relativeTo="$parentDeposit"/>
          </Anchors>
        </FontString>
      </Layer>

        <!-- Total price (money display [non editable]) -->
      <Layer level="BACKGROUND">
        <FontString inherits="GameFontNormal" Text="AUCTIONATOR_L_TOTAL_PRICE" name="$parentTotal">
          <Anchors>
            <Anchor point="TOPLEFT" relativePoint="BOTTOMLEFT" relativeTo="$parentDepositPrice"/>
          </Anchors>
        </FontString>
      </Layer>

      <Layer level="BACKGROUND">
        <FontString inherits="GameFontHighlight" name="$parentTotalPrice">
          <Size y="25"/>
          <Anchors>
            <Anchor point="TOPLEFT" relativePoint="BOTTOMLEFT" relativeTo="$parentTotal"/>
          </Anchors>
        </FontString>
      </Layer>
    </Layers>
  </Frame>
</Ui>
