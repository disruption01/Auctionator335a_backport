<Ui xmlns="http://www.blizzard.com/wow/ui/">
  <Frame name="AuctionatorTabWrapperTemplate" hidden="true" virtual="true">
    <Anchors>
      <Anchor point="TOPLEFT" x="12"/>
      <Anchor point="BOTTOMRIGHT" y="10"/>
    </Anchors>
    <Layers>
      <Layer>
        <FontString inherits="GameFontNormal" name="$parentTitle">
          <Anchors>
            <Anchor point="TOP" y="-18"/>
          </Anchors>
        </FontString>
      </Layer>
    </Layers>
  <Scripts><OnLoad>if self:GetName() then self.Title = _G[self:GetName() .. 'Title'] end</OnLoad></Scripts></Frame>
</Ui>
