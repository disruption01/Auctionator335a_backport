<Ui>
  <Frame name="AuctionatorShoppingTabClassicFrameTemplate" virtual="true" inherits="AuctionatorShoppingTabFrameTemplate">
    <Frames>
      <Button inherits="AuctionatorLoadAllButton" text="AUCTIONATOR_L_LOAD_MORE_RESULTS" hidden="true" name="$parentLoadAllPagesButton">
        <Anchors>
          <Anchor point="BOTTOMLEFT" relativeTo="$parentShoppingResultsInset"/>
          <Anchor point="TOPRIGHT" relativePoint="BOTTOMRIGHT" y="20" relativeTo="$parentShoppingResultsInset"/>
        </Anchors>
        <Scripts>
          <OnLoad>Mixin(self, AuctionatorShoppingTabClassicLoadAllButtonMixin); if self:GetParent() then self:GetParent().LoadAllPagesButton = self end; if self.OnLoad then self:OnLoad() end</OnLoad>
          <OnClick>if self.OnClick then self:OnClick(button, down) end</OnClick>
        </Scripts>
      </Button>
    </Frames>
  </Frame>
</Ui>
