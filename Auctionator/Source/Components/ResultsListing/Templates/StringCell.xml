<Ui xmlns="http://www.blizzard.com/wow/ui/">
  <Button name="AuctionatorStringCellTemplate" inherits="AuctionatorCell" virtual="true">
    <Layers>
      <Layer level="BACKGROUND">
        <FontString inherits="GameFontHighlight" name="$parenttext"><Anchors><Anchor point="TOPLEFT"/><Anchor point="BOTTOMRIGHT"/></Anchors></FontString>
      </Layer>
    </Layers>
    <Scripts>
      <OnLoad>Mixin(self, AuctionatorStringCellTemplateMixin); if self:GetName() then self.text = _G[self:GetName() .. 'text'] end</OnLoad><OnShow>if self.OnShow then self:OnShow() end</OnShow>
      <OnHide>if self.OnHide then self:OnHide() end</OnHide>
    </Scripts>
  </Button>
</Ui>
