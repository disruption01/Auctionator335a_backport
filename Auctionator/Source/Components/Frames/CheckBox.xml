<Ui xmlns="http://www.blizzard.com/wow/ui/">
  <!-- Template for a single option "box" containing a checkbox -->
  <Frame name="AuctionatorConfigurationCheckbox" inherits="AuctionatorConfigurationTooltip" virtual="true">
    <!--
      <KeyValues>
        <KeyValue key="labelText" value="" type="string"/>
        <KeyValue key="tooltipTitleText" value="" type="string"/>
        <KeyValue key="tooltipText" value="" type="string"/>
      </KeyValues>
    -->
    <Size y="40"/>
    <Scripts>
      <OnLoad>Mixin(self, AuctionatorConfigCheckboxMixin); if self.OnLoad then self:OnLoad() end</OnLoad>
      <OnMouseUp>if self.OnMouseUp then self:OnMouseUp(button) end</OnMouseUp>
      <OnEnter>if self.OnEnter then self:OnEnter() end</OnEnter>
      <OnLeave>if self.OnLeave then self:OnLeave() end</OnLeave>
    </Scripts>
    <Anchors>
      <Anchor point="LEFT" relativePoint="LEFT" relativeTo="$parent"/>
      <Anchor point="RIGHT" relativePoint="RIGHT" relativeTo="$parent"/>
    </Anchors>
    <Frames>
      <CheckButton inherits="UICheckButtonTemplate" name="$parentCheckBox">
        <Anchors>
          <Anchor point="TOPLEFT" x="20"/>
        </Anchors>
        <Layers>
          <Layer level="BACKGROUND">
            <FontString inherits="GameFontHighlight" name="$parentLabel">
              <Anchors>
                <Anchor point="TOPLEFT" relativePoint="TOPLEFT" x="58" y="-8" relativeTo="$parent"/>
              </Anchors>
            </FontString>
          </Layer>
        </Layers>
        <Scripts>
          <OnLoad>if self:GetParent() then self:GetParent().CheckBox = self end; if self:GetName() then self.Label = _G[self:GetName() .. 'Label'] end</OnLoad><OnEnter>self:GetParent():OnEnter()</OnEnter>
          <OnLeave>self:GetParent():OnLeave()</OnLeave>
        </Scripts>
      </CheckButton>
    </Frames>
  </Frame>
</Ui>
