<Ui xmlns="http://www.blizzard.com/wow/ui/">
  <!-- Template for a simple input box -->
  <Frame name="AuctionatorConfigurationTextInput" inherits="AuctionatorConfigurationTooltip" virtual="true">
    <!--
      <KeyValues>
        <KeyValue key="tooltipTitleText" value="" type="string"/>
        <KeyValue key="tooltipText" value="" type="string"/>
      </KeyValues>
    -->
    <Size y="20"/>
    <Scripts>
      <OnLoad>Mixin(self, AuctionatorConfigTextInputMixin); if self.OnLoad then self:OnLoad() end</OnLoad>
      <OnMouseUp>if self.OnMouseUp then self:OnMouseUp(button) end</OnMouseUp>
    </Scripts>
    <Anchors>
      <Anchor point="LEFT" relativePoint="LEFT" relativeTo="$parent"/>
      <Anchor point="RIGHT" relativePoint="RIGHT" relativeTo="$parent"/>
    </Anchors>
    <Frames>
      <EditBox autoFocus="false" inherits="LargeInputBoxTemplate" name="$parentInputBox">
        <Size x="140" y="20"/>
        <Anchors>
          <Anchor point="TOPLEFT" x="25"/>
        </Anchors>
        <FontString inherits="ChatFontNormal" justifyH="LEFT"/>
        <Scripts>
          <OnLoad>if self:GetParent() then self:GetParent().InputBox = self end</OnLoad><OnEnter>self:GetParent():OnEnter()</OnEnter>
          <OnLeave>self:GetParent():OnLeave()</OnLeave>
          <OnEscapePressed>self:ClearFocus()</OnEscapePressed>
        </Scripts>
      </EditBox>
    </Frames>
  </Frame>
</Ui>
