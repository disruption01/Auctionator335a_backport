<Ui xmlns="http://www.blizzard.com/wow/ui/">
  <Frame name="AuctionatorDropDown" virtual="true">
    <!--
      <KeyValues>
        <KeyValue key="labelText" value="" type="string"/>
        <KeyValue key="textString" value="CONSTANT_1;CONSTANT_2;..." type="string">
        <KeyValue key="valuesString" value="string_1;string_2;..." type="string">
      </KeyValues>
    -->
    <Scripts>
      <OnLoad>Mixin(self, AuctionatorDropDownMixin); if self:GetName() then self.Label = _G[self:GetName() .. 'Label'] end; if self.OnLoad then self:OnLoad() end</OnLoad>
    </Scripts>
    <Size y="40"/>

    <Frames>
      <Button name="$parentDropDown" inherits="WowStyle1DropdownTemplate">
        <Anchors>
          <Anchor point="TOPLEFT" relativePoint="TOPLEFT" x="20" y="-3" relativeTo="$parent"/>
        </Anchors>
        <Scripts><OnLoad>if self:GetParent() then self:GetParent().DropDown = self end</OnLoad></Scripts>
      </Button>
    </Frames>
    <Layers>
      <Layer level="BACKGROUND">
        <FontString inherits="GameFontHighlight" name="$parentLabel">
          <Anchors>
            <Anchor point="LEFT" relativePoint="RIGHT" x="15" relativeTo="$parentDropDown"/>
            <Anchor point="TOP" relativePoint="TOP" y="-8" relativeTo="$parent"/>
          </Anchors>
        </FontString>
      </Layer>
    </Layers>
    <Anchors>
      <Anchor point="LEFT" relativePoint="LEFT" relativeTo="$parent"/>
      <Anchor point="RIGHT" relativePoint="RIGHT" relativeTo="$parent"/>
    </Anchors>
  </Frame>
</Ui>
