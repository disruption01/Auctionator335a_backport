<Ui xmlns="http://www.blizzard.com/wow/ui/">
  <!-- Template for a radio button with label -->
  <Frame name="AuctionatorConfigurationRadioButton" inherits="AuctionatorConfigurationTooltip" virtual="true">
    <!--
      <KeyValues>
        <KeyValue key="value" value="" type="string"/>
        <KeyValue key="labelText" value="" type="string"/>
        <KeyValue key="tooltipTitleText" value="" type="string"/>
        <KeyValue key="tooltipText" value="" type="string"/>
      </KeyValues>
    -->
    <Size y="20"/>
    <Scripts>
      <OnLoad>Mixin(self, AuctionatorConfigRadioButtonMixin); if self.OnLoad then self:OnLoad() end</OnLoad>
      <OnMouseUp>if self.OnMouseUp then self:OnMouseUp(button) end</OnMouseUp>
      <OnEnter>if self.OnEnter then self:OnEnter() end</OnEnter>
      <OnLeave>if self.OnLeave then self:OnLeave() end</OnLeave>
    </Scripts>
    <Anchors>
      <Anchor point="LEFT" relativePoint="LEFT" relativeTo="$parent"/>
      <Anchor point="RIGHT" relativePoint="RIGHT" relativeTo="$parent"/>
    </Anchors>
    <Frames>
      <CheckButton inherits="UIRadioButtonTemplate" name="$parentRadioButton">
        <Size x="18" y="18"/>
        <Anchors>
          <Anchor point="TOPLEFT" x="20" y="-5"/>
        </Anchors>
        <Layers>
          <Layer level="BACKGROUND">
            <FontString inherits="GameFontHighlight" name="$parentLabel">
              <Anchors>
                <Anchor point="TOPLEFT" relativePoint="TOPLEFT" x="40" y="-8" relativeTo="$parent"/>
              </Anchors>
            </FontString>
          </Layer>
        </Layers>
        <Scripts>
          <OnLoad>if self:GetParent() then self:GetParent().RadioButton = self end; if self:GetName() then self.Label = _G[self:GetName() .. 'Label'] end</OnLoad><OnEnter>self:GetParent():OnEnter()</OnEnter>
          <OnLeave>self:GetParent():OnLeave()</OnLeave>
          <OnClick>self:GetParent():OnClick()</OnClick>
        </Scripts>
      </CheckButton>
    </Frames>
  </Frame>
</Ui>
