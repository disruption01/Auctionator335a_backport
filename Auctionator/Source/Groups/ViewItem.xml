<Ui>
  <Button name="AuctionatorGroupsViewItemTemplate" registerForClicks="LeftButtonUp, RightButtonUp" virtual="true">
    <Scripts>
      <OnLoad>Mixin(self, AuctionatorGroupsViewItemMixin); self.clickEventName = 'BagItemClicked'; if self:GetName() then self.Icon = _G[self:GetName() .. 'Icon'] end; if self:GetName() then self.EmptySlot = _G[self:GetName() .. 'EmptySlot'] end; if self:GetName() then self.IconBorder = _G[self:GetName() .. 'IconBorder'] end; if self:GetName() then self.IconSelectedHighlight = _G[self:GetName() .. 'IconSelectedHighlight'] end; if self:GetName() then self.Text = _G[self:GetName() .. 'Text'] end; if self:GetName() then self.Highlight = _G[self:GetName() .. 'Highlight'] end</OnLoad><OnEnter>if self.OnEnter then self:OnEnter() end</OnEnter>
      <OnLeave>if self.OnLeave then self:OnLeave() end</OnLeave>
      <OnClick>if self.OnClick then self:OnClick(button, down) end</OnClick>
    </Scripts>

    <Layers>
      <Layer level="BACKGROUND">
        <Texture name="$parentIcon">
          <Anchors>
            <Anchor point="TOPLEFT"/>
            <Anchor point="BOTTOMRIGHT"/>
          </Anchors>
        </Texture>
      </Layer>
      <Layer level="BACKGROUND">
        <Texture file="Interface\BUTTONS\UI-Slot-Background" name="$parentEmptySlot">
          <Anchors>
            <Anchor point="TOPLEFT"/>
            <Anchor point="BOTTOMRIGHT"/>
          </Anchors>
          <TexCoords left="0" right="0.640625" top="0" bottom="0.640625"/>
        </Texture>
      </Layer>
      <Layer level="BACKGROUND">
        <Texture file="Interface\Buttons\UI-ActionButton-Border" name="$parentIconBorder">
          <Anchors>
            <Anchor point="TOPLEFT"/>
            <Anchor point="BOTTOMRIGHT"/>
          </Anchors>
        </Texture>
        <Texture file="Interface\Buttons\UI-ActionButton-Border" name="$parentIconSelectedHighlight">
          <Anchors>
            <Anchor point="TOPLEFT"/>
            <Anchor point="BOTTOMRIGHT"/>
          </Anchors>
        </Texture>
      </Layer>
      <Layer>
        <FontString inherits="NumberFontNormal" justifyH="RIGHT" maxLines="1" name="$parentText">
         <Color a="1" r="1" g="1" b="1"/>
          <Size x="0" y="18"/>
          <Anchors>
            <Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMRIGHT" x="-3" y="3" relativeTo="$parent"/>
            <Anchor point="LEFT" relativePoint="LEFT" relativeTo="$parent"/>
          </Anchors>
        </FontString>
      </Layer>
    </Layers>
    <PushedTexture file="Interface\Buttons\UI-Quickslot-Depress">
      <Anchors>
        <Anchor point="TOPLEFT" relativePoint="TOPLEFT" relativeTo="$parentIcon"/>
        <Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMRIGHT" relativeTo="$parentIcon"/>
      </Anchors>
    </PushedTexture>
    <HighlightTexture file="Interface\Buttons\ButtonHilight-Square" alphaMode="ADD" name="$parentHighlight">
      <Anchors>
        <Anchor point="TOPLEFT" relativePoint="TOPLEFT" relativeTo="$parentIcon"/>
        <Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMRIGHT" relativeTo="$parentIcon"/>
      </Anchors>
    </HighlightTexture>
  </Button>
</Ui>
