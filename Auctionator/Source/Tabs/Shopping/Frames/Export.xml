<Ui xmlns="http://www.blizzard.com/wow/ui/">
  <Frame name="AuctionatorExportListTemplate" inherits="AuctionatorSimplePanelTemplate" frameStrata="Dialog" enableMouse="true" virtual="true" hidden="true">
    <Size x="350" y="320"/>

    <Scripts>
      <OnLoad>Mixin(self, AuctionatorListExportFrameMixin); if self.OnLoad then self:OnLoad() end</OnLoad>
      <OnShow>if self.OnShow then self:OnShow() end</OnShow>
      <OnHide>if self.OnHide then self:OnHide() end</OnHide>
    </Scripts>

    <Frames>
      <Frame inherits="AuctionatorInsetDarkTemplate" name="$parentInset">
        <Anchors>
          <Anchor point="TOPLEFT" x="4" y="-30"/>
          <Anchor point="BOTTOMRIGHT" x="-6" y="32"/>
        </Anchors>
      <Scripts><OnLoad>if self:GetParent() then self:GetParent().Inset = self end</OnLoad></Scripts></Frame>

      <Slider inherits="WowTrimScrollBar" name="$parentScrollBar">
        <Anchors>
          <Anchor point="TOPRIGHT" relativePoint="TOPRIGHT" relativeTo="$parentInset"/>
          <Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMRIGHT" relativeTo="$parentInset"/>
        </Anchors>
      <Scripts><OnLoad>if self:GetParent() then self:GetParent().ScrollBar = self end</OnLoad></Scripts></Slider>

      <Frame inherits="WowScrollBox" name="$parentScrollBox">
        <Anchors>
          <Anchor point="TOPLEFT" relativePoint="TOPLEFT" x="5" y="-6" relativeTo="$parentInset"/>
          <Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMLEFT" y="4" relativeTo="$parentScrollBar"/>
        </Anchors>
        <Frames>
          <Frame inherits="ResizeLayoutFrame" name="$parentListListingFrame">
            <Scripts><OnLoad>if self:GetParent() then self:GetParent().ListListingFrame = self end; self.scrollable = true</OnLoad></Scripts></Frame>
        </Frames>
      <Scripts><OnLoad>if self:GetParent() then self:GetParent().ScrollBox = self end</OnLoad></Scripts></Frame>

