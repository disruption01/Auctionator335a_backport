      <!-- Action Buttons -->
      <Button inherits="UIPanelCloseButton" name="$parentCloseDialog">
        <Anchors>
          <Anchor point="TOPRIGHT" relativePoint="TOPRIGHT" relativeTo="$parent"/>
        </Anchors>
        <Scripts>
          <OnLoad>if self:GetParent() then self:GetParent().CloseDialog = self end</OnLoad><OnClick>self:GetParent():OnCloseDialogClicked()</OnClick>
        </Scripts>
      </Button>

      <Button inherits="UIPanelDynamicResizeButtonTemplate" text="AUCTIONATOR_L_EXPORT" name="$parentExport">
        <Anchors>
          <Anchor point="TOPRIGHT" relativePoint="BOTTOMRIGHT" y="-3" relativeTo="$parentInset"/>
        </Anchors>
        <Scripts>
          <OnLoad>if self:GetParent() then self:GetParent().Export = self end</OnLoad><OnClick>self:GetParent():OnExportClicked()</OnClick>
        </Scripts>
      </Button>

      <Button inherits="UIPanelDynamicResizeButtonTemplate" text="AUCTIONATOR_L_SELECT_ALL" name="$parentSelectAll">
        <Anchors>
          <Anchor point="TOPLEFT" relativePoint="BOTTOMLEFT" y="-3" relativeTo="$parentInset"/>
        </Anchors>
        <Scripts>
          <OnLoad>if self:GetParent() then self:GetParent().SelectAll = self end</OnLoad><OnClick>self:GetParent():OnSelectAllClicked()</OnClick>
        </Scripts>
      </Button>

      <Button inherits="UIPanelDynamicResizeButtonTemplate" text="AUCTIONATOR_L_UNSELECT_ALL" name="$parentUnselectAll">
        <Anchors>
          <Anchor point="TOPLEFT" relativePoint="TOPRIGHT" relativeTo="$parentSelectAll"/>
        </Anchors>
        <Scripts>
          <OnLoad>if self:GetParent() then self:GetParent().UnselectAll = self end</OnLoad><OnClick>self:GetParent():OnUnselectAllClicked()</OnClick>
        </Scripts>
      </Button>
    </Frames>

    <Layers>
      <Layer>
        <FontString text="AUCTIONATOR_L_LIST_EXPORT_HEADER" inherits="GameFontHighlight">
          <Anchors>
            <Anchor point="TOP" relativePoint="TOP" y="-10"/>
          </Anchors>
        </FontString>
      </Layer>
    </Layers>
  </Frame>
