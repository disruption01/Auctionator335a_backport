<Ui xmlns="http://www.blizzard.com/wow/ui/">
  <Frame name="AuctionatorImportListTemplate" inherits="AuctionatorSimplePanelTemplate" frameStrata="Dialog" enableMouse="true" virtual="true" hidden="true">
    <Size x="350" y="320"/>

    <Scripts>
      <OnLoad>Mixin(self, AuctionatorListImportFrameMixin); if self.OnLoad then self:OnLoad() end</OnLoad>
      <OnShow>if self.OnShow then self:OnShow() end</OnShow>
      <OnHide>if self.OnHide then self:OnHide() end</OnHide>
    </Scripts>

    <Frames>
      <Frame inherits="AuctionatorInsetDarkTemplate" name="$parentInset">
        <Anchors>
          <Anchor point="TOPLEFT" x="4" y="-30"/>
          <Anchor point="BOTTOMRIGHT" x="-6" y="32"/>
        </Anchors>
      <Scripts><OnLoad>if self:GetParent() then self:GetParent().Inset = self end</OnLoad></Scripts></Frame>

      <Slider inherits="WowTrimScrollBar" name="$parentScrollBar">
        <Anchors>
          <Anchor point="TOPRIGHT" relativePoint="TOPRIGHT" relativeTo="$parentInset"/>
          <Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMRIGHT" relativeTo="$parentInset"/>
        </Anchors>
      <Scripts><OnLoad>if self:GetParent() then self:GetParent().ScrollBar = self end</OnLoad></Scripts></Slider>

      <EditBox inherits="ScrollingEditBoxTemplate" name="$parentEditBoxContainer" autoFocus="false">
        <Anchors>
          <Anchor point="TOPLEFT" relativePoint="TOPLEFT" x="5" y="-6" relativeTo="$parentInset"/>
          <Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMRIGHT" x="-27" y="4" relativeTo="$parentInset"/>
        </Anchors>
      <Scripts><OnLoad>if self:GetParent() then self:GetParent().EditBoxContainer = self end</OnLoad></Scripts></EditBox>

      <!-- Action Buttons -->
      <Button inherits="UIPanelCloseButton" name="$parentCloseDialog">
        <Anchors>
          <Anchor point="TOPRIGHT" relativePoint="TOPRIGHT" relativeTo="$parent"/>
        </Anchors>
        <Scripts>
          <OnLoad>if self:GetParent() then self:GetParent().CloseDialog = self end</OnLoad><OnClick>self:GetParent():OnCloseDialogClicked()</OnClick>
        </Scripts>
      </Button>

      <Button inherits="UIPanelDynamicResizeButtonTemplate" text="AUCTIONATOR_L_IMPORT" name="$parentImport">
        <Anchors>
          <Anchor point="TOPRIGHT" relativePoint="BOTTOMRIGHT" y="-3" relativeTo="$parentInset"/>
        </Anchors>
        <Scripts>
          <OnLoad>if self:GetParent() then self:GetParent().Import = self end</OnLoad><OnClick>self:GetParent():OnImportClicked()</OnClick>
        </Scripts>
      </Button>
    </Frames>

    <Layers>
      <Layer>
        <FontString text="AUCTIONATOR_L_LIST_IMPORT_HEADER" inherits="GameFontHighlight">
          <Anchors>
            <Anchor point="TOP" relativePoint="TOP" y="-10"/>
          </Anchors>
        </FontString>
      </Layer>
    </Layers>
  </Frame>
</Ui>
