<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
	<!-- Elements are required to be buttons for now -->
	<Button name="AuctionatorRetailImportTemplatedListElementTemplate" virtual="true">
		<Scripts>
			<OnLoad>Mixin(self, AuctionatorRetailImportTemplatedListElementMixin)</OnLoad><OnClick>if self.OnClick then self:OnClick(button, down) end</OnClick>
			<OnEnter>if self.OnEnter then self:OnEnter() end</OnEnter>
			<OnLeave>if self.OnLeave then self:OnLeave() end</OnLeave>
		</Scripts>
	</Button>


	<Frame name="AuctionatorRetailImportTemplatedListTemplate" virtual="true">
		<Frames>
			<Frame frameStrata="HIGH" name="$parentArtOverlay">
				<Layers>
					<Layer level="OVERLAY">
						<Texture hidden="true" name="$parentSelectedHighlight">
							<Color r="1" g="0.8" b="0.2" a="0.2"/>
						</Texture>
					</Layer>
				</Layers>
			<Scripts><OnLoad>if self:GetParent() then self:GetParent().ArtOverlay = self end; if self:GetName() then self.SelectedHighlight = _G[self:GetName() .. 'SelectedHighlight'] end</OnLoad></Scripts></Frame>
		</Frames>
		<Scripts>
			<OnLoad>Mixin(self, AuctionatorRetailImportTemplatedListMixin)</OnLoad><OnShow>if self.OnShow then self:OnShow() end</OnShow>
		</Scripts>
	</Frame>
</Ui>
